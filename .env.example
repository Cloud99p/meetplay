# MeetPlay environment variables — copy to `.env` and fill in.

# --- LiveKit Cloud (required for real video/audio) ---
# Instance: meetplay-3pba3wsu
LIVEKIT_URL=wss://meetplay-3pba3wsu.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Speech-to-text mode ---
# mock       -> MockAdapter (default; deterministic script, zero keys, buildathon/demo)
# webspeech  -> WebSpeechAdapter (browser-native STT, free, NO speaker diarization)
# deepgram   -> DeepgramAdapter (production: streaming + diarized; needs key below)
VITE_STT_MODE=mock

# --- Deepgram (only needed when VITE_STT_MODE=deepgram) ---
# Get a key at https://console.deepgram.com (Live API access)
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Optional: server URL override for deployed frontend ---
# VITE_SERVER_URL=https://your-server.example.com
