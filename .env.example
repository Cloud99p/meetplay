# MeetPlay environment variables — copy to `.env` for local dev, and add the
# same values (server vars) to your Railway/Render/Fly service settings.
# NEVER commit the real `.env` (gitignored).

# =============================================================================
# LIVEKIT (REQUIRED for video/audio — get from https://cloud.livekit.io)
# =============================================================================
# Your LiveKit Cloud instance URL, e.g. wss://<project>.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional: explicit host for the server-side health probe
# LIVEKIT_HOST=localhost:7880

# =============================================================================
# SERVER (optional but recommended for production)
# =============================================================================
# Secret for signing room tokens — set a long random string in production
# (e.g. `openssl rand -hex 32`). Dev default exists if unset.
JWT_SECRET=

# Deepgram API key (REQUIRED when VITE_STT_MODE=deepgram) — used SERVER-SIDE
# by the /api/stt proxy, so the key never ships to the browser.
# Get one at https://console.deepgram.com (Live API access required).
DEEPGRAM_API_KEY=

*** Deepgram model (default nova-2):
#   nova-2          -> v1 /listen, diarized multi-speaker (REQUIRED for the
#                      "Who Said That?" game to know who spoke)
#   flux-general-en -> v2 /listen, turn-based (StartOfTurn/EndOfTurn events,
#                      eot_threshold/eot_timeout_ms) — single-speaker stream,
#                      ultra-low latency, no diarization
# DEEPGRAM_MODEL=nova-2

# Postgres connection string. If unset (or USE_MEMORY_DB=1), an in-memory DB
# is used (data resets on restart - fine for demos).
# Schema migrations run AUTOMATICALLY at boot (idempotent), so an empty
# database needs no manual psql step. Full setup + backup guide:
# docs/POSTGRES.md
#
# Use the SESSION POOLER (port 5432), not "Direct connection": on the free tier
# db.<ref>.supabase.co is IPv6-only, and the 6543 transaction pooler breaks
# pg_dump/migrations. The pooler host is REGION-SPECIFIC. The user is the role
# PLUS the project ref. Password must be URL-encoded (@ -> %40, " -> %22).
# DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
# USE_MEMORY_DB=0
#
# Sanity checks after configuring (see docs/POSTGRES.md):
#   node --env-file=.env scripts/verify-postgres.mjs       # schema + data path
#   node --env-file=.env scripts/verify-db-security.mjs    # Data API stays shut
#
# TLS for managed providers (Supabase/Railway/Neon/RDS). Unset = TLS on for
# any non-localhost host, off for localhost. Other values: verify | disable
# DATABASE_SSL=require
#
# Connection pool size (default 10). Keep within the pooler's project limit.
# DATABASE_POOL_MAX=10
#
# Local backups: `node scripts/db-backup.mjs` keeps the newest N dumps.
# BACKUP_KEEP=14

# API rate limit per IP per minute (default 120)
# RATE_LIMIT_MAX=120

# =============================================================================
# OMNILEARN (Meeting Intelligence / knowledge graph �?" OPTIONAL)
# =============================================================================
# MeetPlay records meeting utterances into the Omnilearn knowledge graph and
# reads them back for "Who Said That?" quotes + recap questions.
#
# Omnilearn V1 API base URL. Points at the Omnilearn api-server. Leave the
# default when running Omnilearn locally on :8080.
OMNILEARN_URL=http://localhost:8080

# Optional API key (sent as `x-api-key`). Omnilearn runs keyless for local
# dev, so this is usually empty. Set in production when auth is enabled.
# OMNILEARN_API_KEY=

# Set to 0 to disable recording entirely (games/recap then run purely from
# the in-memory buffer). Default 1.
# OMNILEARN_ENABLED=1

# =============================================================================
# CALL RECORDING (LiveKit Egress -> S3-compatible bucket) - OPTIONAL
# =============================================================================
# Recording works ONLY when a storage destination is configured: LiveKit
# egress has no managed storage of its own, so every recording is uploaded to
# a bucket YOU supply. Without these vars the host's record button stays
# disabled with a clear reason.
#
# Any S3-compatible provider works (Cloudflare R2 recommended: 10 GB free,
# zero egress fees). Create a bucket, then set:
#
#   S3_BUCKET          bucket name (REQUIRED — nothing else can substitute for it)
#   S3_ACCESS_KEY      access key id (R2: "Access Key ID")
#                      aliases: S3_ACCESS_KEY_ID, Access_Key_ID
#   S3_SECRET          secret access key (aliases: S3_SECRET_ACCESS_KEY,
#                      Secret_Access_Key — Cloudflare's own field labels)
#   S3_ENDPOINT        https://<account-id>.r2.cloudflarestorage.com
#                      (omit entirely for real AWS S3)
#   S3_REGION          R2 uses "auto" (default); AWS uses e.g. us-east-1
#   S3_FORCE_PATH_STYLE required by R2/MinIO/B2 - default ON, set 0 for AWS
#
#   S3_PUBLIC_BASE_URL public bucket/CDN URL (e.g. https://pub-xxxx.r2.dev).
#                      OPTIONAL — only for a PUBLIC bucket. Leave this unset and
#                      the server instead mints short-lived SIGned URLs for
#                      playback (bucket stays private, links expire). See
#                      RECORDING_URL_TTL_SECONDS below.
#                      Alias: R2_PUBLIC_BASE_URL
#   S3_PREFIX          key prefix inside the bucket (default "meetplay")
#
# RECORDING_URL_TTL_SECONDS  how long a signed playback link stays valid
#                      (default 3600 = 1h; capped at 7 days by SigV4). Every
#                      recap load mints a fresh one, so short is better: a
#                      leaked recap link dies quickly instead of exposing the
#                      recording forever.
#
# RECORDING_ENABLED=0     force-off (button disabled with a reason)
# RECORDING_AUDIO_ONLY=1  audio-only .ogg (Opus). ~4x cheaper egress minutes
#                         ($0.005/min vs $0.02/min) and avoids minors-on-video
#                         in student sessions. Default: 0 (video .mp4)
# RECORDING_PRESET=H264_1080P_30   video preset (H264_720P_30 = smaller files)

# Port the server listens on (Railway injects PORT automatically)
# PORT=3001

# =============================================================================
# CLIENT (VITE_* — baked into the frontend at BUILD time)
# =============================================================================
# Speech-to-text mode: mock | webspeech | deepgram
#   mock      -> MockAdapter (deterministic script, zero keys; default, demo)
#   webspeech -> browser-native STT (free, NO speaker diarization)
#   deepgram  -> production streaming STT with diarization (needs DEEPGRAM_API_KEY)
VITE_STT_MODE=deepgram

# Optional client-side LiveKit URL override (usually not needed — the server
# provides the URL; useful when the client can't reach the server default).
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional: override the API server URL the frontend talks to
# (useful when frontend and backend are served from different origins).
# VITE_SERVER_URL=https://your-server.example.com

# SERVER: drop final captions below this confidence from games/recap (still shown dimmed in the overlay)
# CAPTION_CONFIDENCE_FLOOR=0.5
