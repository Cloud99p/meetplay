{
  "name": "meetplay-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "db:up": "docker run -d --name meetplay-pg-test -e POSTGRES_PASSWORD=testpass -e POSTGRES_USER=meetplay -e POSTGRES_DB=meetplay -p 55432:5432 postgres:17",
    "db:down": "docker rm -f meetplay-pg-test",
    "db:verify": "node scripts/verify-postgres.mjs",
    "db:verify:security": "node scripts/verify-db-security.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:status": "node --env-file=.env scripts/db-status.mjs",
    "db:fingerprint": "node --env-file=.env scripts/schema-fingerprint.mjs",
    "verify:persistence": "node --env-file=.env scripts/verify-persistence.mjs",
    "verify:recording": "node scripts/verify-recording-egress.mjs",
    "verify:presign": "npx tsx scripts/verify-presign.ts",
    "verify:r2": "node --env-file=.env scripts/verify-r2-live.mjs",
    "verify:caption": "node scripts/verify-caption-speaker.mjs",
    "verify:stt": "node --env-file=.env scripts/verify-stt-proxy.mjs",
    "verify:stt:guards": "node --env-file=.env scripts/verify-stt-guards.mjs",
    "verify:host": "node scripts/verify-host-return.mjs",
    "verify:ws-limits": "node scripts/verify-ws-limits.mjs",
    "verify:health": "node --env-file=.env scripts/verify-health.mjs",
    "verify:hand": "node scripts/verify-hand-raise.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.1",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.9.1",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.1.18",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "globals": "^16.5.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^4.5.0"
  }
}
